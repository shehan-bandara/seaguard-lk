
# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
APP_NAME=SeaGuardLK
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
TZ=Asia/Colombo

# ==========================================
# BACKEND CONFIGURATION
# ==========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=seaguard_db
POSTGRES_USER=seaguard_user
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql://seaguard_user:change_me@localhost:5432/seaguard_db

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ==========================================
# SECURITY
# ==========================================
SECRET_KEY=replace_with_generated_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# WEATHER DATA SOURCES
# ==========================================
METEO_BASE_URL=https://meteo.gov.lk
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1

OPENWEATHER_API_KEY=
STORMGLASS_API_KEY=

# ==========================================
# DATA PIPELINE
# ==========================================
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_FETCH_INTERVAL_MINUTES=60
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# ==========================================
# FORECASTING
# ==========================================
FORECAST_DAYS=7
FORECAST_UPDATE_INTERVAL_MINUTES=60

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=INFO
LOG_DIR=logs
